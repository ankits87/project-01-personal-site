# Supabase (contact form storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (contact form email notifications)
RESEND_API_KEY=

# Feature flags
# Set to "true" to show the light/dark theme toggle button in the navbar.
# Defaults to disabled (off) when unset.
NEXT_PUBLIC_ENABLE_THEME_TOGGLE=false
